COPERNICUS_USER=your_esa_username
COPERNICUS_PASSWORD=your_esa_password
SAR_INFERENCE_CMD=python /app/orchestration/inference/run_inference.py --input "{input}" --model "{model}"

AIS_HTTP_URL=https://your-ais-provider.example.com/v1/positions
AIS_HTTP_API_KEY=your_provider_api_key
AIS_HTTP_AUTH_HEADER=Authorization
AIS_HTTP_AUTH_SCHEME=Bearer
AIS_HTTP_POLL_INTERVAL_SEC=30
AIS_HTTP_TIMEOUT_SEC=20
AIS_HTTP_RETRY_ATTEMPTS=3
AIS_HTTP_RETRY_BACKOFF_SEC=2

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

AIS_RAW_TOPIC=ais.raw.position_reports
AIS_CLEANED_TOPIC=ais.cleaned.position_reports
AIS_FEATURES_TOPIC=ais.features.vessel_tracks
AIS_DEADLETTER_TOPIC=ais.deadletter

AIS_STREAM_PROCESSOR_GROUP_ID=ais-stream-processor-v1
AIS_STATE_BACKEND=redis
AIS_REDIS_URL=redis://localhost:6379/0
AIS_VESSEL_WINDOW_SIZE=20
AIS_VESSEL_STATE_TTL_SEC=86400
AIS_POLL_TIMEOUT_MS=1000

AIS_ANOMALY_GROUP_ID=ais-anomaly-detector-v1
AIS_ANOMALIES_TOPIC=ais.anomalies.events
AIS_ANOMALY_MODEL_NAME=IsolationForest-Placeholder-v0
AIS_ANOMALY_SCORE_THRESHOLD=0.65
AIS_ANOMALY_POLL_TIMEOUT_MS=1000
