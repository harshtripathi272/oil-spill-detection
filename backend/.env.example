# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./oilspill.db
# For Supabase (PostgreSQL) - uncomment and fill in your values
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_SERVICE_KEY=[YOUR-SUPABASE-SERVICE-KEY]

# Airflow Integration
AIRFLOW_DB_URL=sqlite:////data/user13/airflow/airflow.db
AIRFLOW_DAGS_FOLDER=/data/user13/oilspill_ugq/oil-spill-detection/orchestration/dags

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Services
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SAR_TRIGGER_TOPIC=sar-trigger-events
SAR_TRIGGER_GROUP_ID=sar-detection-group

# Logging
LOG_LEVEL=INFO